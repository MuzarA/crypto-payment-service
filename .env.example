# Скопируйте в .env и поменяйте пароль и ключи
WALLET_BACKEND=bitcoin
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=change-me-strong-password
SERVICE_WALLET=_payment_service
AUTO_MINE=true
FEE_RESERVE=0.0001
# Магазины (сервисы-клиенты) и их API-ключи: merchant_id:api_key через запятую
MERCHANT_API_KEYS=demo-shop:demo-key,another-shop:another-key
